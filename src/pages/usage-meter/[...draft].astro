---
// Product page for Usage Meter. Deliberately not in the portfolio style: it
// follows the app's own design system (docs/DESIGN.md in josbez/claude-usage),
// with the system font, macOS greys, the stress ramp and light/dark from the OS.
//
// The copy lives in src/content/products/usage-meter.md (written in Obsidian).
// With `draft: true` there, this page is only generated in `astro dev`.
import { getImage } from 'astro:assets';
import icon from '../../content/projects/images/usage-meter/app-icon.png';
import popoverDark from '../../content/projects/images/usage-meter/popover-dark.png';
import popoverLight from '../../content/projects/images/usage-meter/popover-light.png';
import settingsDark from '../../content/projects/images/usage-meter/settings-dark.png';
import settingsLight from '../../content/projects/images/usage-meter/settings-light.png';
import ogSource from '../../content/projects/images/usage-meter/og.jpg';
import { getEntry } from 'astro:content';
import siteConfig from '../../data/site-config';
import { asLink, asStep, parseProductCopy } from '../../utils/product-copy';

export async function getStaticPaths() {
    const entry = await getEntry('products', 'usage-meter');
    return entry && (import.meta.env.DEV || !entry.data.draft) ? [{ params: { draft: undefined } }] : [];
}

const entry = (await getEntry('products', 'usage-meter'))!;
const { title, description } = entry.data;
const copy = parseProductCopy(entry.body ?? '');
const { header, hero, faces: facesCopy, features, settings, privacy, install, faq, final, footer } = copy;
const heroButtons = (hero?.list ?? []).map((item) => asLink(item.raw)).filter((link) => link !== undefined);
const finalButtons = (final?.list ?? []).map((item) => asLink(item.raw)).filter((link) => link !== undefined);
const navLinks = (header?.list ?? []).map((item) => asLink(item.raw)).filter((link) => link !== undefined);
const steps = (install?.list ?? []).map((item) => asStep(item.raw));
const canonical = new URL('/usage-meter/', siteConfig.website).toString();

const shot = (src: ImageMetadata, width: number) => getImage({ src, width, format: 'webp', quality: 90 });
const [popL, popD, setL, setD, icon64, icon160, og] = await Promise.all([
    shot(popoverLight, 720),
    shot(popoverDark, 720),
    shot(settingsLight, 720),
    shot(settingsDark, 720),
    getImage({ src: icon, width: 64, format: 'png' }),
    getImage({ src: icon, width: 160, format: 'png' }),
    getImage({ src: ogSource, width: 1200, height: 630, format: 'jpeg' })
]);

// The faces the app shows by session usage (data from the app, not copy)
const faces = [
    { face: '🚀', pct: 0 },
    { face: '🙂', pct: 20 },
    { face: '😅', pct: 40 },
    { face: '😨', pct: 60 },
    { face: '😰', pct: 75 },
    { face: '😱', pct: 90 },
    { face: '💀', pct: 100 }
];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="color-scheme" content="light dark" />
        {entry.data.draft && <meta name="robots" content="noindex" />}
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/png" href={icon64.src} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL(og.src, siteConfig.website).toString()} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="author" content="Jos Bezemer" />
        <script
            type="application/ld+json"
            set:html={JSON.stringify({
                '@context': 'https://schema.org',
                '@type': 'SoftwareApplication',
                name: 'Usage Meter',
                operatingSystem: 'macOS 11 or later',
                applicationCategory: 'UtilitiesApplication',
                offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
                downloadUrl: heroButtons[0]?.href,
                author: { '@type': 'Person', name: siteConfig.title, url: siteConfig.website },
                url: canonical
            })}
        />
    </head>
    <body>
        <header class="top wrap">
            <a class="brand" href="/usage-meter/">
                <img src={icon64.src} width="28" height="28" alt="" />
                <span>Usage Meter</span>
            </a>
            {
                navLinks.length > 0 && (
                    <nav aria-label="Usage Meter">
                        {navLinks.map((link) => (
                            <a href={link.href}>{link.label}</a>
                        ))}
                    </nav>
                )
            }
        </header>

        <main>
            {
                hero && (
                    <section class="hero wrap">
                        <div class="hero-text">
                            <img class="hero-icon" src={icon160.src} width="80" height="80" alt="Usage Meter app icon: a smiley inside a usage ring" />
                            <h1 set:html={hero.title} />
                            {hero.paragraphs[0] && <p class="lede" set:html={hero.paragraphs[0]} />}
                            {heroButtons.length > 0 && (
                                <div class="actions">
                                    {heroButtons.map((link, index) => (
                                        <a class:list={['btn', index === 0 ? 'primary' : 'secondary']} href={link.href}>
                                            {link.label}
                                        </a>
                                    ))}
                                </div>
                            )}
                            {hero.paragraphs.slice(1).map((html) => (
                                <p class="meta" set:html={html} />
                            ))}
                        </div>
                        <div class="hero-visual" aria-hidden="true">
                            <div class="menubar">
                                <span class="menubar-item">
                                    <svg width="15" height="15" viewBox="0 0 16 16">
                                        <circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-opacity="0.35" stroke-width="2" />
                                        <circle
                                            cx="8"
                                            cy="8"
                                            r="6.5"
                                            fill="none"
                                            stroke="currentColor"
                                            stroke-width="2"
                                            stroke-linecap="round"
                                            stroke-dasharray="25.32 40.84"
                                            transform="rotate(-90 8 8)"
                                        />
                                    </svg>
                                    62% / 41% · 2h10m
                                </span>
                                <span class="menubar-clock">Sat 11 Oct 15:42</span>
                            </div>
                            <picture>
                                <source srcset={popD.src} media="(prefers-color-scheme: dark)" />
                                <img class="popover" src={popL.src} width="360" height="356" alt="" />
                            </picture>
                        </div>
                    </section>
                )
            }

            {
                facesCopy && (
                    <section class="wrap section">
                        <h2 set:html={facesCopy.title} />
                        {facesCopy.paragraphs.map((html) => (
                            <p class="section-lede" set:html={html} />
                        ))}
                        <div class="card ramp">
                            <ol class="faces" aria-label="Faces by session usage">
                                {faces.map(({ face, pct }) => (
                                    <li style={`--at: ${pct}%`}>
                                        <span class="face" aria-hidden="true">
                                            {face}
                                        </span>
                                        <span class="pct">{pct}%</span>
                                    </li>
                                ))}
                            </ol>
                            <div class="ramp-bar" />
                        </div>
                    </section>
                )
            }

            {
                features && (
                    <section class="wrap section">
                        <h2 set:html={features.title} />
                        {features.paragraphs.map((html) => (
                            <p class="section-lede" set:html={html} />
                        ))}
                        <div class="grid">
                            {features.items.map((item) => (
                                <div class="card feature">
                                    <h3 set:html={item.title} />
                                    {item.paragraphs.map((html) => (
                                        <p set:html={html} />
                                    ))}
                                </div>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                settings && (
                    <section class="wrap section split">
                        <div>
                            <h2 set:html={settings.title} />
                            {settings.paragraphs.map((html) => (
                                <p class="section-lede" set:html={html} />
                            ))}
                        </div>
                        <picture>
                            <source srcset={setD.src} media="(prefers-color-scheme: dark)" />
                            <img
                                class="popover"
                                src={setL.src}
                                width="360"
                                height="662"
                                loading="lazy"
                                decoding="async"
                                alt="Usage Meter settings: menu bar style, icon, appearance, notifications, refresh interval, and a row per source."
                            />
                        </picture>
                    </section>
                )
            }

            {
                privacy && (
                    <section class="wrap section">
                        <h2 set:html={privacy.title} />
                        {privacy.paragraphs.map((html) => (
                            <p class="section-lede" set:html={html} />
                        ))}
                        <ul class="card checklist">
                            {privacy.list.map((item) => (
                                <li set:html={item.html} />
                            ))}
                        </ul>
                    </section>
                )
            }

            {
                install && (
                    <section class="wrap section" id="install">
                        <h2 set:html={install.title} />
                        <ol class="steps">
                            {steps.map((step, index) => (
                                <li class="card">
                                    <span class="n">{index + 1}</span>
                                    <div>
                                        <Fragment set:html={step.html} />
                                        {step.command && (
                                            <div class="code">
                                                <code tabindex="0" aria-label="Install command">
                                                    {step.command}
                                                </code>
                                                <button type="button" class="copy" data-copy={step.command}>
                                                    Copy
                                                </button>
                                            </div>
                                        )}
                                    </div>
                                </li>
                            ))}
                        </ol>
                        {install.paragraphs.map((html) => (
                            <p class="note" set:html={html} />
                        ))}
                    </section>
                )
            }

            {
                faq && (
                    <section class="wrap section">
                        <h2 set:html={faq.title} />
                        <div class="faq">
                            {faq.items.map((item) => (
                                <details class="card">
                                    <summary set:html={item.title} />
                                    {item.paragraphs.map((html) => (
                                        <p set:html={html} />
                                    ))}
                                </details>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                final && (
                    <section class="wrap section final">
                        <img src={icon160.src} width="64" height="64" alt="" />
                        <h2 set:html={final.title} />
                        {finalButtons.length > 0 && (
                            <div class="actions center">
                                {finalButtons.map((link, index) => (
                                    <a class:list={['btn', index === 0 ? 'primary' : 'secondary']} href={link.href}>
                                        {link.label}
                                    </a>
                                ))}
                            </div>
                        )}
                        {final.paragraphs.map((html) => (
                            <p class="meta" set:html={html} />
                        ))}
                    </section>
                )
            }
        </main>

        {
            footer && (
                <footer class="wrap foot">
                    {footer.paragraphs.map((html) => (
                        <p set:html={html} />
                    ))}
                </footer>
            )
        }

        <script>
            document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
                button.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(button.dataset.copy ?? '');
                        button.textContent = 'Copied';
                        setTimeout(() => (button.textContent = 'Copy'), 1500);
                    } catch {
                        button.textContent = 'Select and copy';
                    }
                });
            });
        </script>
    </body>
</html>

<style is:global>
    /* Tokens from the app's design system (docs/DESIGN.md), plus page sizes */
    :root {
        --bg: #f0f0f0;
        --card-bg: #ffffff;
        --text: #1a1a1a;
        --muted: #636366;
        --track: #eaeaea;
        --accent-text: #3366d6;
        --accent-fill-strong: #3366d6;
        --on-accent: #ffffff;
        --status-ok: #34c759;
        --stress-low: #2fa84a;
        --stress-mid: #ff9500;
        --stress-high: #ff3b30;
        --radius-sm: 5px;
        --radius-md: 8px;
        --radius-card: 12px;
        --font-system: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', Arial, sans-serif;
        --font-mono: ui-monospace, 'SF Mono', Menlo, monospace;
        --page: 1040px;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --bg: #1c1c1e;
            --card-bg: #2c2c2e;
            --text: #f2f2f2;
            --muted: #ababb0;
            --track: #3a3a3c;
            --accent-text: #6b93f5;
        }
    }

    * {
        box-sizing: border-box;
    }
    html {
        -webkit-text-size-adjust: 100%;
    }
    body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-system);
        font-size: 17px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
    }
    a {
        color: var(--accent-text);
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
    /* Links in running text need more than colour to stand out (WCAG 1.4.1) */
    p a,
    li a {
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    :focus-visible {
        outline: 2px solid var(--accent-text);
        outline-offset: 2px;
        border-radius: 3px;
    }
    h1,
    h2,
    h3 {
        margin: 0;
        letter-spacing: -0.02em;
        line-height: 1.1;
    }
    h1 {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 700;
    }
    h2 {
        font-size: clamp(1.6rem, 3.2vw, 2.25rem);
        font-weight: 700;
    }
    h3 {
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
    }

    .wrap {
        width: 100%;
        max-width: var(--page);
        margin-inline: auto;
        padding-inline: 20px;
    }

    .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 18px;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text);
        font-weight: 600;
    }
    .brand:hover {
        text-decoration: none;
    }
    .top nav {
        display: flex;
        gap: 20px;
        font-size: 15px;
    }
    .top nav a {
        color: var(--muted);
    }
    @media (max-width: 480px) {
        .top nav {
            gap: 14px;
            font-size: 14px;
        }
    }
    .top nav a:hover {
        color: var(--text);
        text-decoration: none;
    }

    .hero {
        display: grid;
        grid-template-columns: 1fr;
        gap: 48px;
        padding-block: 48px 72px;
        align-items: center;
    }
    @media (min-width: 900px) {
        .hero {
            grid-template-columns: 1.05fr 1fr;
            padding-block: 72px 112px;
        }
    }
    .hero-icon {
        display: block;
        width: 80px;
        height: 80px;
        margin-bottom: 24px;
    }
    .lede {
        margin: 20px 0 0;
        font-size: 1.25rem;
        color: var(--muted);
        max-width: 34em;
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 32px;
    }
    .actions.center {
        justify-content: center;
    }
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 10px 20px;
        border-radius: var(--radius-md);
        font-size: 16px;
        font-weight: 600;
        transition:
            background-color 0.15s,
            filter 0.15s;
    }
    .btn:hover {
        text-decoration: none;
    }
    .btn.primary {
        background: var(--accent-fill-strong);
        color: var(--on-accent);
    }
    .btn.primary:hover {
        filter: brightness(1.1);
    }
    .btn.secondary {
        background: var(--card-bg);
        color: var(--text);
        box-shadow: inset 0 0 0 1px var(--track);
    }
    .btn.secondary:hover {
        background: var(--track);
    }
    .meta {
        margin: 16px 0 0;
        font-size: 14px;
        color: var(--muted);
    }

    .hero-visual {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .menubar {
        width: 100%;
        max-width: 480px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 18px;
        padding: 5px 14px;
        border-radius: var(--radius-md);
        background: color-mix(in srgb, var(--card-bg) 80%, transparent);
        box-shadow: inset 0 0 0 1px var(--track);
        font-size: 13px;
        font-weight: 500;
        white-space: nowrap;
    }
    .menubar-item {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 1px 8px;
        border-radius: var(--radius-sm);
        background: var(--track);
    }
    .menubar-clock {
        color: var(--muted);
    }
    .popover {
        display: block;
        width: 100%;
        max-width: 360px;
        height: auto;
        border-radius: var(--radius-card);
        box-shadow:
            0 0 0 1px rgb(0 0 0 / 0.06),
            0 24px 60px rgb(0 0 0 / 0.18);
    }
    .hero-visual .popover {
        margin-top: 10px;
    }
    @media (max-width: 420px) {
        .menubar-clock {
            display: none;
        }
    }

    .section {
        padding-block: 56px;
    }
    .section-lede {
        margin: 16px 0 0;
        font-size: 1.125rem;
        color: var(--muted);
        max-width: 40em;
    }
    .card {
        background: var(--card-bg);
        border-radius: var(--radius-card);
    }

    .ramp {
        margin-top: 32px;
        padding: 28px 24px 24px;
    }
    .faces {
        position: relative;
        list-style: none;
        margin: 0 0 12px;
        padding: 0;
        height: 64px;
    }
    .faces li {
        position: absolute;
        left: var(--at);
        transform: translateX(calc(var(--at) * -1));
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .face {
        font-size: 30px;
        line-height: 1;
    }
    .pct {
        margin-top: 6px;
        font-size: 12px;
        color: var(--muted);
        font-variant-numeric: tabular-nums;
    }
    .ramp-bar {
        height: 8px;
        border-radius: 4px;
        background: linear-gradient(90deg, var(--stress-low), var(--stress-mid) 50%, var(--stress-high));
    }
    /* Narrow: spread the faces evenly instead of at their exact percentage */
    @media (max-width: 520px) {
        .faces {
            display: flex;
            justify-content: space-between;
            height: auto;
        }
        .faces li {
            position: static;
            transform: none;
        }
        .face {
            font-size: 22px;
        }
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 16px;
        margin-top: 32px;
    }
    @media (min-width: 720px) {
        .grid {
            grid-template-columns: 1fr 1fr;
        }
    }
    .feature {
        padding: 24px;
    }
    .feature p {
        margin: 8px 0 0;
        color: var(--muted);
        font-size: 16px;
    }

    .split {
        display: grid;
        grid-template-columns: 1fr;
        gap: 40px;
        align-items: center;
    }
    .split picture {
        justify-self: center;
    }
    @media (min-width: 900px) {
        .split {
            grid-template-columns: 1fr 1fr;
        }
    }

    .checklist {
        list-style: none;
        margin: 32px 0 0;
        padding: 8px 24px;
    }
    .checklist li {
        position: relative;
        padding: 14px 0 14px 32px;
    }
    .checklist li + li {
        border-top: 1px solid var(--track);
    }
    .checklist li::before {
        content: '';
        position: absolute;
        left: 2px;
        top: 21px;
        width: 12px;
        height: 7px;
        border-left: 2px solid var(--status-ok);
        border-bottom: 2px solid var(--status-ok);
        transform: rotate(-45deg);
    }

    .steps {
        list-style: none;
        margin: 32px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
    }
    .steps li {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        padding: 18px 20px;
    }
    .n {
        flex: none;
        display: inline-grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--track);
        font-size: 14px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }
    .steps li > div {
        padding-top: 2px;
        min-width: 0;
    }
    .code {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
        padding: 10px 10px 10px 14px;
        border-radius: var(--radius-md);
        background: var(--bg);
    }
    .code code {
        flex: 1;
        min-width: 0;
        overflow-x: auto;
        white-space: nowrap;
        font-family: var(--font-mono);
        font-size: 14px;
    }
    .copy {
        flex: none;
        min-height: 32px;
        padding: 4px 12px;
        border: 0;
        border-radius: var(--radius-sm);
        background: var(--card-bg);
        color: var(--text);
        box-shadow: inset 0 0 0 1px var(--track);
        font: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }
    .copy:hover {
        background: var(--track);
    }
    .note {
        margin: 20px 0 0;
        font-size: 15px;
        color: var(--muted);
    }

    .faq {
        display: grid;
        gap: 10px;
        margin-top: 32px;
    }
    .faq details {
        padding: 0 20px;
    }
    .faq summary {
        cursor: pointer;
        list-style: none;
        display: flex;
        justify-content: space-between;
        gap: 16px;
        padding: 18px 0;
        font-weight: 600;
    }
    .faq summary::-webkit-details-marker {
        display: none;
    }
    .faq summary::after {
        content: '+';
        color: var(--muted);
        font-weight: 400;
        font-size: 20px;
        line-height: 1;
    }
    .faq details[open] summary::after {
        content: '–';
    }
    .faq details p {
        margin: 0;
        padding: 0 0 20px;
        color: var(--muted);
    }

    .final {
        text-align: center;
        padding-block: 80px;
    }
    .final img {
        display: block;
        margin: 0 auto 20px;
    }

    .foot {
        padding-block: 32px 48px;
        border-top: 1px solid var(--track);
        font-size: 14px;
        color: var(--muted);
    }
    .foot p {
