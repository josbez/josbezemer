---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" showHeader={false}>
    <article class="mb-16 sm:mb-24">
        <header class="mb-8">
            <h1 class="text-3xl leading-tight sm:text-5xl sm:leading-tight">Page not found</h1>
        </header>
        <div class="prose sm:prose-lg max-w-none">
            <p>This page doesn't exist or has moved.</p>
            <p><a href="/">Go home</a> or browse <a href="/notes">the notes</a>.</p>
        </div>
    </article>
</BaseLayout>
