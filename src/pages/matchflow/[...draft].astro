---
// Product page for Matchflow, in the app's own style (docs/design/styleguide.md
// in josbez/matchflow-app): light, warm and calm, system font, live green.
//
// The copy lives in src/content/products/matchflow.md (written in Obsidian).
// With `draft: true` there, this page is only generated in `astro dev`.
import { getImage } from 'astro:assets';
import icon from '../../content/projects/images/matchflow/app-icon.png';
import lineups from '../../content/projects/images/matchflow/lineups.png';
import ogSource from '../../content/projects/images/matchflow/og.jpg';
import popoverDark from '../../content/projects/images/matchflow/popover-dark.png';
import popoverLight from '../../content/projects/images/matchflow/popover-light.png';
import stats from '../../content/projects/images/matchflow/stats.png';
import widgetLarge from '../../content/projects/images/matchflow/widget-large-dark.png';
import widgetMedium from '../../content/projects/images/matchflow/widget-medium.png';
import widgetSmall from '../../content/projects/images/matchflow/widget-small.png';
import { getEntry } from 'astro:content';
import siteConfig from '../../data/site-config';
import { asLink, asStep, parseProductCopy } from '../../utils/product-copy';

export async function getStaticPaths() {
    const entry = await getEntry('products', 'matchflow');
    return entry && (import.meta.env.DEV || !entry.data.draft) ? [{ params: { draft: undefined } }] : [];
}

const entry = (await getEntry('products', 'matchflow'))!;
const { title, description } = entry.data;
const copy = parseProductCopy(entry.body ?? '');
const { header, hero, states, features, follow, lineups: lineupsCopy, widgets, notifications, calm, install, faq, final, footer } = copy;
const links = (section?: { list: { raw: string }[] }) => (section?.list ?? []).map((item) => asLink(item.raw)).filter((link) => link !== undefined);
const heroButtons = links(hero);
const finalButtons = links(final);
const navLinks = links(header);
const steps = (install?.list ?? []).map((item) => asStep(item.raw));
const canonical = new URL('/matchflow/', siteConfig.website).toString();

const shot = (src: ImageMetadata) => getImage({ src, width: 720, format: 'webp', quality: 90 });
const [popL, popD, lineupsImg, statsImg, wSmall, wMedium, wLarge, icon64, icon160, og] = await Promise.all([
    shot(popoverLight),
    shot(popoverDark),
    shot(lineups),
    shot(stats),
    getImage({ src: widgetSmall, width: 340, format: 'webp', quality: 90 }),
    getImage({ src: widgetMedium, width: 728, format: 'webp', quality: 90 }),
    getImage({ src: widgetLarge, width: 728, format: 'webp', quality: 90 }),
    getImage({ src: icon, width: 64, format: 'png' }),
    getImage({ src: icon, width: 160, format: 'png' }),
    getImage({ src: ogSource, width: 1200, height: 630, format: 'jpeg' })
]);

// Menu bar states: the home colour fills up to the home side's share of the momentum.
// The captions come from the list in the {#states} section, in this order.
const stateShares = [72, 50, 24];
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <meta name="color-scheme" content="light dark" />
        {entry.data.draft && <meta name="robots" content="noindex" />}
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />
        <link rel="icon" type="image/png" href={icon64.src} />
        <meta property="og:type" content="website" />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:image" content={new URL(og.src, siteConfig.website).toString()} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="author" content="Jos Bezemer" />
    </head>
    <body>
        <header class="top wrap">
            <a class="brand" href="/matchflow/">
                <img src={icon64.src} width="28" height="28" alt="" />
                <span>Matchflow</span>
            </a>
            {
                navLinks.length > 0 && (
                    <nav aria-label="Matchflow">
                        {navLinks.map((link) => (
                            <a href={link.href}>{link.label}</a>
                        ))}
                    </nav>
                )
            }
        </header>

        <main>
            {
                hero && (
                    <section class="hero wrap">
                        <div>
                            <img
                                class="hero-icon"
                                src={icon160.src}
                                width="80"
                                height="80"
                                alt="Matchflow app icon: a football pitch split in two club colours"
                            />
                            <h1 set:html={hero.title} />
                            {hero.paragraphs[0] && <p class="lede" set:html={hero.paragraphs[0]} />}
                            {heroButtons.length > 0 && (
                                <div class="actions">
                                    {heroButtons.map((link, index) => (
                                        <a class:list={['btn', index === 0 ? 'primary' : 'secondary']} href={link.href}>
                                            {link.label}
                                        </a>
                                    ))}
                                </div>
                            )}
                            {hero.paragraphs.slice(1).map((html) => (
                                <p class="meta" set:html={html} />
                            ))}
                        </div>
                        <div class="hero-visual" aria-hidden="true">
                            <div class="menubar">
                                <span class="bug" style="--share: 72%">
                                    <span class="bug-text">
                                        FEY <b>1–1</b> UTR
                                    </span>
                                    <span class="bug-bar" />
                                </span>
                                <span class="menubar-clock">Sat 18:47</span>
                            </div>
                            <picture>
                                <source srcset={popD.src} media="(prefers-color-scheme: dark)" />
                                <img class="popover" src={popL.src} width="360" height="686" alt="" />
                            </picture>
                        </div>
                    </section>
                )
            }

            {
                states && (
                    <section class="wrap section">
                        <h2 set:html={states.title} />
                        {states.paragraphs.map((html) => (
                            <p class="section-lede" set:html={html} />
                        ))}
                        <div class="states">
                            {stateShares.map((share, index) => (
                                <figure class="card state">
                                    <span class="bug" style={`--share: ${share}%`} aria-hidden="true">
                                        <span class="bug-text">
                                            FEY <b>1–1</b> UTR
                                        </span>
                                        <span class="bug-bar" />
                                    </span>
                                    {states.list[index] && <figcaption set:html={states.list[index].html} />}
                                </figure>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                [features, follow].map(
                    (section, index) =>
                        section && (
                            <section class="wrap section">
                                <h2 set:html={section.title} />
                                {section.paragraphs.map((html) => (
                                    <p class="section-lede" set:html={html} />
                                ))}
                                <div class:list={['grid', { three: index === 1 }]}>
                                    {section.items.map((item) => (
                                        <div class="card feature">
                                            <h3 set:html={item.title} />
                                            {item.paragraphs.map((html) => (
                                                <p set:html={html} />
                                            ))}
                                        </div>
                                    ))}
                                </div>
                            </section>
                        )
                )
            }

            {
                lineupsCopy && (
                    <section class="wrap section split">
                        <div>
                            <h2 set:html={lineupsCopy.title} />
                            {lineupsCopy.paragraphs.map((html) => (
                                <p class="section-lede" set:html={html} />
                            ))}
                        </div>
                        <div class="pair">
                            <img
                                class="popover"
                                src={lineupsImg.src}
                                width="360"
                                height="568"
                                loading="lazy"
                                decoding="async"
                                alt="The line-ups page: both teams on one pitch with shirt numbers, names, live ratings, goals and cards."
                            />
                            <img
                                class="popover"
                                src={statsImg.src}
                                width="360"
                                height="568"
                                loading="lazy"
                                decoding="async"
                                alt="The stats pane: attacking sides per team and the key stats with a bar per club."
                            />
                        </div>
                    </section>
                )
            }

            {
                widgets && (
                    <section class="wrap section">
                        <h2 set:html={widgets.title} />
                        {widgets.paragraphs.map((html) => (
                            <p class="section-lede" set:html={html} />
                        ))}
                        <div class="widgets">
                            <img
                                src={wSmall.src}
                                width="170"
                                height="170"
                                loading="lazy"
                                decoding="async"
                                alt="Small widget: the score with the momentum bar."
                            />
                            <img
                                src={wMedium.src}
                                width="364"
                                height="170"
                                loading="lazy"
                                decoding="async"
                                alt="Medium widget: Feyenoord 5–0 Utrecht at 67 minutes, the momentum bar, the flow chart and the goals."
                            />
                            <img
                                src={wLarge.src}
                                width="364"
                                height="382"
                                loading="lazy"
                                decoding="async"
                                alt="Large widget in dark mode: the match, the flow and the live table with what each club plays now."
                            />
                        </div>
                    </section>
                )
            }

            {
                [notifications, calm].map(
                    (section) =>
                        section && (
                            <section class="wrap section">
                                <h2 set:html={section.title} />
                                {section.paragraphs.map((html) => (
                                    <p class="section-lede" set:html={html} />
                                ))}
                                {section.list.length > 0 && (
                                    <ul class="chips">
                                        {section.list.map((item) => (
                                            <li set:html={item.html} />
                                        ))}
                                    </ul>
                                )}
                            </section>
                        )
                )
            }

            {
                install && (
                    <section class="wrap section" id="install">
                        <h2 set:html={install.title} />
                        <ol class="steps">
                            {steps.map((step, index) => (
                                <li class="card">
                                    <span class="n">{index + 1}</span>
                                    <div>
                                        <Fragment set:html={step.html} />
                                        {step.command && (
                                            <div class="code">
                                                <code tabindex="0" aria-label="Install command">
                                                    {step.command}
                                                </code>
                                                <button type="button" class="copy" data-copy={step.command}>
                                                    Copy
                                                </button>
                                            </div>
                                        )}
                                    </div>
                                </li>
                            ))}
                        </ol>
                        {install.paragraphs.map((html) => (
                            <p class="note" set:html={html} />
                        ))}
                    </section>
                )
            }

            {
                faq && (
                    <section class="wrap section">
                        <h2 set:html={faq.title} />
                        <div class="faq">
                            {faq.items.map((item) => (
                                <details class="card">
                                    <summary set:html={item.title} />
                                    {item.paragraphs.map((html) => (
                                        <p set:html={html} />
                                    ))}
                                </details>
                            ))}
                        </div>
                    </section>
                )
            }

            {
                final && (
                    <section class="wrap section final">
                        <img src={icon160.src} width="64" height="64" alt="" />
                        <h2 set:html={final.title} />
                        {finalButtons.length > 0 && (
                            <div class="actions center">
                                {finalButtons.map((link, index) => (
                                    <a class:list={['btn', index === 0 ? 'primary' : 'secondary']} href={link.href}>
                                        {link.label}
                                    </a>
                                ))}
                            </div>
                        )}
                        {final.paragraphs.map((html) => (
                            <p class="meta" set:html={html} />
                        ))}
                    </section>
                )
            }
        </main>

        {
            footer && (
                <footer class="wrap foot">
                    {footer.paragraphs.map((html) => (
                        <p set:html={html} />
                    ))}
                </footer>
            )
        }

        <script>
            document.querySelectorAll<HTMLButtonElement>('button[data-copy]').forEach((button) => {
                button.addEventListener('click', async () => {
                    try {
                        await navigator.clipboard.writeText(button.dataset.copy ?? '');
                        button.textContent = 'Copied';
                        setTimeout(() => (button.textContent = 'Copy'), 1500);
                    } catch {
                        button.textContent = 'Select and copy';
                    }
                });
            });
        </script>
    </body>
</html>

<style is:global>
    /* From the app's style guide: warm cream like the icon tile, live green,
       home red and away navy from the icon; contrast checked for text */
    :root {
        --bg: #f7f3ec;
        --card: #fffdf9;
        --text: #1d1d1f;
        --secondary: #5e5e5e;
        --line: rgb(29 29 31 / 0.08);
        --live: #13703a;
        --home: #d9242a;
        --away: #1f3a5f;
        --button: #1d1d1f;
        --on-button: #ffffff;
        --radius: 10px;
        --font-system: -apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Helvetica Neue', Arial, sans-serif;
        --font-mono: ui-monospace, 'SF Mono', Menlo, monospace;
        --page: 1040px;
    }
    @media (prefers-color-scheme: dark) {
        :root {
            --bg: #1e1e1e;
            --card: #2a2a2a;
            --text: #f2f2f2;
            --secondary: #b3b3b3;
            --line: rgb(255 255 255 / 0.1);
            --live: #4ade80;
            --away: #e8e4dc;
            --button: #f2f2f2;
            --on-button: #1d1d1f;
        }
    }

    * {
        box-sizing: border-box;
    }
    html {
        -webkit-text-size-adjust: 100%;
    }
    body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        font-family: var(--font-system);
        font-size: 17px;
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
    }
    a {
        color: var(--live);
        text-decoration: none;
    }
    a:hover {
        text-decoration: underline;
    }
    /* Links in running text need more than colour to stand out (WCAG 1.4.1) */
    p a,
    li a {
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    :focus-visible {
        outline: 2px solid var(--live);
        outline-offset: 2px;
        border-radius: 3px;
    }
    h1,
    h2,
    h3 {
        margin: 0;
        letter-spacing: -0.02em;
        line-height: 1.1;
    }
    h1 {
        font-size: clamp(2.25rem, 5vw, 3.5rem);
        font-weight: 700;
    }
    h2 {
        font-size: clamp(1.6rem, 3.2vw, 2.25rem);
        font-weight: 700;
    }
    h3 {
        font-size: 1.0625rem;
        font-weight: 600;
        letter-spacing: -0.01em;
    }

    .wrap {
        width: 100%;
        max-width: var(--page);
        margin-inline: auto;
        padding-inline: 20px;
    }

    .top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding-block: 18px;
    }
    .brand {
        display: inline-flex;
        align-items: center;
        gap: 10px;
        color: var(--text);
        font-weight: 600;
    }
    .brand:hover {
        text-decoration: none;
    }
    .top nav {
        display: flex;
        gap: 20px;
        font-size: 15px;
    }
    .top nav a {
        color: var(--secondary);
    }
    .top nav a:hover {
        color: var(--text);
        text-decoration: none;
    }
    @media (max-width: 480px) {
        .top nav {
            gap: 14px;
            font-size: 14px;
        }
    }

    .hero {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 48px;
        padding-block: 48px 72px;
        align-items: center;
    }
    @media (min-width: 900px) {
        .hero {
            grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
            padding-block: 72px 112px;
        }
    }
    .hero-icon {
        display: block;
        width: 80px;
        height: 80px;
        margin-bottom: 24px;
    }
    .lede {
        margin: 20px 0 0;
        font-size: 1.25rem;
        color: var(--secondary);
        max-width: 34em;
    }
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 32px;
    }
    .actions.center {
        justify-content: center;
    }
    .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 44px;
        padding: 10px 20px;
        border-radius: 8px;
        font-size: 16px;
        font-weight: 600;
        transition:
            background-color 0.15s,
            opacity 0.15s;
    }
    .btn:hover {
        text-decoration: none;
    }
    .btn.primary {
        background: var(--button);
        color: var(--on-button);
    }
    .btn.primary:hover {
        opacity: 0.85;
    }
    .btn.secondary {
        background: var(--card);
        color: var(--text);
        box-shadow: inset 0 0 0 1px var(--line);
    }
    .btn.secondary:hover {
        background: var(--line);
    }
    .meta {
        margin: 16px 0 0;
        font-size: 14px;
        color: var(--secondary);
    }

    /* The menu bar item: club codes, score, and the tug-of-war bar underneath */
    .bug {
        display: inline-flex;
        flex-direction: column;
        align-items: stretch;
        gap: 3px;
        font-size: 13px;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
    }
    .bug b {
        font-weight: 600;
    }
    .bug-bar {
        position: relative;
        height: 3px;
        border-radius: 2px;
        background: linear-gradient(90deg, var(--home) 0 var(--share), var(--away) var(--share) 100%);
    }
    .bug-bar::after {
        content: '';
        position: absolute;
        left: 50%;
        top: -1px;
        width: 1px;
        height: 5px;
        background: var(--text);
        opacity: 0.5;
    }

    .hero-visual {
        display: flex;
        flex-direction: column;
        align-items: center;
    }
    .menubar {
        width: 100%;
        max-width: 480px;
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 18px;
        padding: 4px 14px;
        border-radius: 8px;
        background: var(--card);
        box-shadow: inset 0 0 0 1px var(--line);
    }
    .menubar .bug {
        padding: 2px 8px;
        border-radius: 5px;
        background: var(--line);
    }
    .menubar-clock {
        font-size: 13px;
        color: var(--secondary);
    }
    .popover {
        display: block;
        width: 100%;
        max-width: 360px;
        height: auto;
        border-radius: 12px;
        box-shadow:
            0 0 0 1px rgb(0 0 0 / 0.06),
            0 24px 60px rgb(60 40 10 / 0.16);
    }
    .hero-visual .popover {
        margin-top: 10px;
    }

    .section {
        padding-block: 56px;
    }
    .section-lede {
        margin: 16px 0 0;
        font-size: 1.125rem;
        color: var(--secondary);
        max-width: 40em;
    }
    .card {
        background: var(--card);
        border-radius: var(--radius);
        box-shadow: inset 0 0 0 1px var(--line);
    }

    .states {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 16px;
        margin-top: 32px;
    }
    .state {
        margin: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 14px;
        padding: 28px 20px 20px;
    }
    .state .bug {
        font-size: 20px;
        gap: 6px;
    }
    .state .bug-bar {
        height: 5px;
    }
    .state figcaption {
        font-size: 15px;
        color: var(--secondary);
    }

    .grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 16px;
        margin-top: 32px;
    }
    @media (min-width: 720px) {
        .grid {
            grid-template-columns: 1fr 1fr;
        }
    }
    @media (min-width: 900px) {
        .grid.three {
            grid-template-columns: repeat(3, 1fr);
        }
    }
    .feature {
        padding: 24px;
    }
    .widgets {
        display: flex;
        flex-wrap: wrap;
        align-items: flex-start;
        gap: 20px;
        margin-top: 32px;
    }
    .widgets img {
        display: block;
        height: auto;
        max-width: 100%;
        border-radius: 20px;
        box-shadow:
            0 0 0 1px rgb(0 0 0 / 0.06),
            0 12px 40px rgb(60 40 10 / 0.14);
    }
    .feature p {
        margin: 8px 0 0;
        color: var(--secondary);
        font-size: 16px;
    }

    .split {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 40px;
        align-items: center;
    }
    @media (min-width: 900px) {
        .split {
            grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
        }
    }
    .pair {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: center;
    }
    .pair .popover {
        flex: 1 1 200px;
        max-width: 280px;
    }

    .chips {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin: 28px 0 0;
        padding: 0;
    }
    .chips li {
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--card);
        box-shadow: inset 0 0 0 1px var(--line);
        font-size: 15px;
    }

    .steps {
        list-style: none;
        margin: 32px 0 0;
        padding: 0;
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 12px;
    }
    .steps li {
        display: flex;
        gap: 16px;
        align-items: flex-start;
        padding: 18px 20px;
    }
    .n {
        flex: none;
        display: inline-grid;
        place-items: center;
        width: 28px;
        height: 28px;
        border-radius: 50%;
        background: var(--line);
        font-size: 14px;
        font-weight: 600;
        font-variant-numeric: tabular-nums;
    }
    .steps li > div {
        padding-top: 2px;
        min-width: 0;
    }
    .code {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 10px;
        padding: 10px 10px 10px 14px;
        border-radius: 8px;
        background: var(--bg);
    }
    .code code {
        flex: 1;
        min-width: 0;
        overflow-x: auto;
        white-space: nowrap;
        font-family: var(--font-mono);
        font-size: 14px;
    }
    .copy {
        flex: none;
        min-height: 32px;
        padding: 4px 12px;
        border: 0;
        border-radius: 6px;
        background: var(--card);
        color: var(--text);
        box-shadow: inset 0 0 0 1px var(--line);
        font: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }
    .copy:hover {
        background: var(--line);
    }
    .note {
        margin: 20px 0 0;
        font-size: 15px;
        color: var(--secondary);
    }

    .faq {
        display: grid;
        gap: 10px;
