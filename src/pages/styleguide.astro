---
import { getCollection } from 'astro:content';
import ArrowLeft from '../assets/icons/arrow-left.svg';
import ArrowRight from '../assets/icons/arrow-right.svg';
import AlsoWorkedWith from '../components/AlsoWorkedWith.astro';
import Button from '../components/Button.astro';
import IconButton from '../components/IconButton.astro';
import Pagination from '../components/Pagination.astro';
import PostPreview from '../components/PostPreview.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';

const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
const samplePost = posts[0];
const sampleProject = projects[0];
const samplePage = { currentPage: 2, lastPage: 3, url: { prev: '#', next: '#' } };

// Keep in sync with the primitives in src/styles/global.css
const primitives = [
    { token: '--color-paper-100', hex: '#f4efe6' },
    { token: '--color-paper-200', hex: '#ece6da' },
    { token: '--color-ink-800', hex: '#271f1a' },
    { token: '--color-ink-900', hex: '#1c1714' },
    { token: '--color-clay-600', hex: '#a54c2a' },
    { token: '--color-clay-400', hex: '#d4724a' }
];

const semantic = [
    { token: '--bg-main', utility: 'bg-main', light: '--color-paper-100', dark: '--color-ink-900', use: 'Page background' },
    { token: '--bg-muted', utility: 'bg-muted', light: '--color-paper-200', dark: '--color-ink-800', use: 'Hover fill, subtle surfaces' },
    { token: '--text-main', utility: 'text-main', light: '--color-ink-900', dark: '--color-paper-100', use: 'All text' },
    { token: '--border-main', utility: 'border-main', light: '--color-ink-900', dark: '--color-paper-100', use: 'Borders, dividers' },
    { token: '--accent', utility: 'text-accent', light: '--color-clay-600', dark: '--color-clay-400', use: 'Links, active nav, emphasis' }
];

const contrast = [
    { pair: 'Text on background', ratio: '15.5 : 1' },
    { pair: 'Accent on background (light)', ratio: '5.0 : 1' },
    { pair: 'Accent on background (dark)', ratio: '5.3 : 1' },
    { pair: 'Accent on muted (light)', ratio: '4.6 : 1' }
];

const typeScale = [
    { name: 'h1', spec: 'Syne 700 · 2.25rem · lh 1.1 · -0.02em', sample: 'Good UX starts before the interface.' },
    { name: 'h2', spec: 'Syne 600 · 1.5rem · lh 1.2', sample: 'Information architecture' },
    { name: 'h3', spec: 'Syne 600 · 1.125rem · lh 1.3', sample: 'Structure is what makes AI useful' },
    { name: 'h4', spec: 'Syne 600 · 0.9375rem · lh 1.4', sample: 'The role of object models' },
    { name: 'h5', spec: 'Syne 600 · 0.8125rem · uppercase · 0.03em', sample: 'Related topics' },
    { name: 'h6', spec: 'Epilogue 500 · 0.75rem · uppercase · 0.08em · 55%', sample: 'April 2026' }
];

const spacing = [
    { name: 'Page gutter', value: 'px-4 → md:px-8' },
    { name: 'Content width', value: 'max-w-3xl (48rem)' },
    { name: 'Text block width', value: 'max-w-xl (36rem)' },
    { name: 'Section gap', value: 'mb-16 → sm:mb-24' },
    { name: 'List item gap', value: 'mb-10 → sm:mb-12' },
    { name: 'Inline gap', value: 'gap-4 · gap-6 · gap-8' }
];
---

<BaseLayout title="Styleguide" description="Design tokens, typography and components that make up josbezemer.nl." showHeader={false}>
    <meta slot="head" name="robots" content="noindex" />
    <article class="mb-16 sm:mb-24">
        <header class="mb-16">
            <h6>Design system</h6>
            <h1 class="mt-2 text-3xl leading-tight sm:text-5xl sm:leading-tight">Styleguide</h1>
            <p class="mt-4 max-w-xl text-sm leading-normal">
                The tokens, type and components behind this site. Everything below is rendered with the real components, so this page cannot drift from
                production. Toggle the theme in the top right to check dark mode.
            </p>
        </header>

        <section class="mb-16 sm:mb-24" aria-labelledby="sg-colors">
            <h2 id="sg-colors" class="border-main mb-8 border-b border-dashed pb-2 font-serif">Colour</h2>

            <h5 class="mb-4">Primitives</h5>
            <ul class="mb-12 grid grid-cols-2 gap-6 sm:grid-cols-3">
                {
                    primitives.map((p) => (
                        <li class="flex items-center gap-3">
                            <span class="border-main/15 h-12 w-12 shrink-0 rounded-full border" style={`background: var(${p.token})`} />
                            <span class="text-sm leading-tight">
                                <code class="block">{p.token}</code>
                                <span class="opacity-55">{p.hex}</span>
                            </span>
                        </li>
                    ))
                }
            </ul>

            <h5 class="mb-4">Semantic</h5>
            <div class="mb-12 overflow-x-auto">
                <table class="w-full min-w-xl text-left text-sm">
                    <thead>
                        <tr class="border-main border-b border-dashed">
                            <th class="py-2 pr-4 font-medium">Token</th>
                            <th class="py-2 pr-4 font-medium">Utility</th>
                            <th class="py-2 pr-4 font-medium">Light</th>
                            <th class="py-2 pr-4 font-medium">Dark</th>
                            <th class="py-2 font-medium">Use</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            semantic.map((s) => (
                                <tr class="border-main/15 border-b">
                                    <td class="py-2 pr-4">
                                        <span class="inline-flex items-center gap-2">
                                            <span class="border-main/15 h-4 w-4 rounded-full border" style={`background: var(${s.token})`} />
                                            <code>{s.token}</code>
                                        </span>
                                    </td>
                                    <td class="py-2 pr-4">
                                        <code>{s.utility}</code>
                                    </td>
                                    <td class="py-2 pr-4 opacity-55">{s.light.replace('--color-', '')}</td>
                                    <td class="py-2 pr-4 opacity-55">{s.dark.replace('--color-', '')}</td>
                                    <td class="py-2">{s.use}</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            <h5 class="mb-4">Contrast (WCAG AA ≥ 4.5)</h5>
            <ul class="text-sm">
                {
                    contrast.map((c) => (
                        <li class="flex justify-between gap-4 py-1">
                            <span>{c.pair}</span>
                            <span class="opacity-55">{c.ratio}</span>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class="mb-16 sm:mb-24" aria-labelledby="sg-type">
            <h2 id="sg-type" class="border-main mb-8 border-b border-dashed pb-2 font-serif">Typography</h2>
            <p class="mb-8 text-sm leading-normal">
                <strong class="font-medium">Syne</strong> (<code>font-serif</code>) for headings, navigation and buttons.
                <strong class="font-medium">Epilogue</strong> (<code>font-sans</code>) for body text and meta.
            </p>

            <div class="flex flex-col gap-8">
                {
                    typeScale.map((t) => {
                        const Tag = t.name as 'h1';
                        return (
                            <div>
                                <p class="mb-1 text-xs opacity-55">
                                    <code>{t.name}</code> · {t.spec}
                                </p>
                                <Tag>{t.sample}</Tag>
                            </div>
                        );
                    })
                }
                <div>
                    <p class="mb-1 text-xs opacity-55">Page title · <code>text-3xl sm:text-5xl leading-tight</code></p>
                    <p class="font-serif text-3xl leading-tight font-bold sm:text-5xl">Good UX starts before the interface.</p>
                </div>
                <div>
                    <p class="mb-1 text-xs opacity-55">Eyebrow · <code>text-xs font-medium tracking-[0.08em] uppercase opacity-55</code></p>
                    <p class="font-sans text-xs font-medium tracking-[0.08em] uppercase opacity-55">Case study</p>
                </div>
                <div>
                    <p class="mb-1 text-xs opacity-55">Meta · <code>text-sm opacity-55</code></p>
                    <p class="text-sm opacity-55">Lead UX Designer · 2025 · 6 months</p>
                </div>
            </div>

            <h5 class="mt-12 mb-4">Long-form (<code>prose sm:prose-lg</code>)</h5>
            <div class="prose sm:prose-lg max-w-none">
                <p>
                    I work on the architecture underneath the interface. The objects, models, flows and decisions that shape every screen,
                    <a href="#">before a single component is drawn</a>.
                </p>
                <blockquote><p>Prompts are the new design choices. Naked, unable to hide behind anything.</p></blockquote>
                <ul>
                    <li>Object models first</li>
                    <li>Flows second</li>
                    <li>Screens last</li>
                </ul>
            </div>
        </section>

        <section class="mb-16 sm:mb-24" aria-labelledby="sg-layout">
            <h2 id="sg-layout" class="border-main mb-8 border-b border-dashed pb-2 font-serif">Layout, borders & shape</h2>
            <ul class="mb-10 text-sm">
                {
                    spacing.map((s) => (
                        <li class="flex justify-between gap-4 py-1">
                            <span>{s.name}</span>
                            <code class="opacity-55">{s.value}</code>
                        </li>
                    ))
                }
            </ul>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-3">
                <div class="border-main flex h-24 items-center justify-center border border-dashed text-sm">Dashed · containers</div>
                <div class="border-main flex h-24 items-center justify-center border-t border-dashed text-sm">Dashed top · dividers</div>
                <div class="border-main flex h-24 items-center justify-center rounded-full border text-sm">Solid pill · controls</div>
            </div>
        </section>

        <section class="mb-16 sm:mb-24" aria-labelledby="sg-components">
            <h2 id="sg-components" class="border-main mb-8 border-b border-dashed pb-2 font-serif">Components</h2>

            <div class="flex flex-col gap-12">
                <div>
                    <h5 class="mb-1">Button</h5>
                    <p class="mb-4 text-sm opacity-55">
                        <code>Button.astro</code> · renders <code>&lt;a&gt;</code> with href, otherwise <code>&lt;button&gt;</code>
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <Button href="#">Get in touch</Button>
                        <Button type="button">Button element</Button>
                        <Button type="button" disabled class="cursor-not-allowed opacity-55">Disabled</Button>
                    </div>
                </div>

                <div>
                    <h5 class="mb-1">Icon button</h5>
                    <p class="mb-4 text-sm opacity-55"><code>IconButton.astro</code> · always pass <code>aria-label</code></p>
                    <div class="flex gap-4">
                        <IconButton type="button" aria-label="Previous"><ArrowLeft class="h-5 w-5 fill-current" /></IconButton>
                        <IconButton type="button" aria-label="Next"><ArrowRight class="h-5 w-5 fill-current" /></IconButton>
                    </div>
                </div>

                <div>
                    <h5 class="mb-1">Text link</h5>
                    <p class="mb-4 text-sm opacity-55">Inline links in prose: accent, dashed underline, solid on hover</p>
                    <div class="prose">
                        <p>Read more in <a href="#">the notes</a>.</p>
                    </div>
                </div>

                <div>
                    <h5 class="mb-1">Input</h5>
                    <p class="mb-4 text-sm opacity-55">From <code>Subscribe.astro</code> · pill, transparent, border-main</p>
                    <input
                        type="email"
                        placeholder="name@example.com"
                        aria-label="Example input"
                        class="text-main border-main placeholder:text-main/60 h-9 w-full max-w-xs rounded-full border bg-transparent px-5 py-2 text-sm focus:outline-hidden"
                    />
                </div>

                {
                    sampleProject && (
                        <div>
                            <h5 class="mb-1">Project preview</h5>
                            <p class="mb-4 text-sm opacity-55">
                                <code>ProjectPreview.astro</code>
                            </p>
                            <ProjectPreview project={sampleProject} headingLevel="h3" />
                        </div>
                    )
                }

                {
                    samplePost && (
                        <div>
                            <h5 class="mb-1">Note preview</h5>
                            <p class="mb-4 text-sm opacity-55">
                                <code>PostPreview.astro</code>
                            </p>
                            <PostPreview post={samplePost} headingLevel="h3" />
                        </div>
                    )
                }

                <div>
                    <h5 class="mb-1">Pagination</h5>
                    <p class="mb-4 text-sm opacity-55"><code>Pagination.astro</code></p>
                    <Pagination page={samplePage} />
                </div>

                <div>
                    <h5 class="mb-1">Also worked with</h5>
                    <p class="mb-4 text-sm opacity-55"><code>AlsoWorkedWith.astro</code></p>
                    <AlsoWorkedWith />
                </div>
            </div>
        </section>

        <section aria-labelledby="sg-rules">
            <h2 id="sg-rules" class="border-main mb-8 border-b border-dashed pb-2 font-serif">Rules</h2>
            <ul class="flex flex-col gap-2 text-sm leading-normal">
                <li>
                    Use semantic utilities only (<code>bg-main</code>, <code>text-main</code>, <code>border-main</code>, <code>text-accent</code>). No hex
                    values in components.
                </li>
                <li>Secondary text is <code>opacity-55</code>, not a new colour.</li>
                <li>Accent is for links, active state and one emphasis per view. Never for large fills.</li>
                <li>Containers and dividers use dashed borders; interactive controls are solid pills.</li>
                <li>Headings and controls in Syne, everything else in Epilogue. No third typeface.</li>
                <li>New component? Add it to this page in the same change.</li>
            </ul>
        </section>
    </article>
</BaseLayout>
