---
import { getCollection } from 'astro:content';
import AlsoWorkedWith from '../components/AlsoWorkedWith.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import IconButton from '../components/IconButton.astro';
import { iconNames } from '../components/icon-names';
import Pagination from '../components/Pagination.astro';
import PostPreview from '../components/PostPreview.astro';
import ProjectPreview from '../components/ProjectPreview.astro';
import Spec from '../components/styleguide/Spec.astro';
import TextField from '../components/TextField.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { sortItemsByDateDesc } from '../utils/data-utils';

const posts = (await getCollection('blog')).sort(sortItemsByDateDesc);
const projects = (await getCollection('projects')).sort(sortItemsByDateDesc);
const samplePost = posts[0];
const sampleProject = projects[0];
const samplePage = { currentPage: 2, lastPage: 3, url: { prev: '#', next: '#' } };

// Keep in sync with the primitives in src/styles/global.css
const primitives = [
    { token: '--color-paper-100', hex: '#f4efe6' },
    { token: '--color-paper-200', hex: '#ece6da' },
    { token: '--color-ink-800', hex: '#271f1a' },
    { token: '--color-ink-900', hex: '#1c1714' },
    { token: '--color-clay-600', hex: '#a54c2a' },
    { token: '--color-clay-400', hex: '#d4724a' },
    { token: '--color-crimson-700', hex: '#9f1d2b' },
    { token: '--color-crimson-300', hex: '#ef7f86' }
];

const semantic = [
    { token: '--bg-main', utility: 'bg-main', light: '--color-paper-100', dark: '--color-ink-900', use: 'Page background' },
    { token: '--bg-muted', utility: 'bg-muted', light: '--color-paper-200', dark: '--color-ink-800', use: 'Hover fill, subtle surfaces, code' },
    { token: '--text-main', utility: 'text-main', light: '--color-ink-900', dark: '--color-paper-100', use: 'All text' },
    { token: '--border-main', utility: 'border-main', light: '--color-ink-900', dark: '--color-paper-100', use: 'Borders, dividers' },
    { token: '--accent', utility: 'text-accent', light: '--color-clay-600', dark: '--color-clay-400', use: 'Links, active nav, focus ring' },
    { token: '--danger', utility: 'text-danger', light: '--color-crimson-700', dark: '--color-crimson-300', use: 'Errors and destructive feedback only' }
];

const contrast = [
    { pair: 'Text on background', ratio: '15.5 : 1' },
    { pair: 'Accent on background (light / dark)', ratio: '5.0 / 5.3 : 1' },
    { pair: 'Accent on muted (light)', ratio: '4.6 : 1' },
    { pair: 'Danger on background (light / dark)', ratio: '6.8 / 6.8 : 1' }
];

const typeScale = [
    { name: 'h1', spec: 'Syne 700 · 2.25rem · lh 1.1 · -0.02em', sample: 'Good UX starts before the interface.' },
    { name: 'h2', spec: 'Syne 600 · 1.5rem · lh 1.2', sample: 'Information architecture' },
    { name: 'h3', spec: 'Syne 600 · 1.125rem · lh 1.3', sample: 'Structure is what makes AI useful' },
    { name: 'h4', spec: 'Syne 600 · 0.9375rem · lh 1.4', sample: 'The role of object models' },
    { name: 'h5', spec: 'Syne 600 · 0.8125rem · uppercase · 0.03em', sample: 'Related topics' },
    { name: 'h6', spec: 'Epilogue 500 · 0.75rem · uppercase · 0.08em · 55%', sample: 'April 2026' }
];

const spacing = [
    { name: 'Page gutter', value: 'px-4 → md:px-8' },
    { name: 'Content width', value: 'max-w-3xl (48rem)' },
    { name: 'Text block width', value: 'max-w-xl (36rem)' },
    { name: 'Section gap', value: 'mb-16 → sm:mb-24' },
    { name: 'List item gap', value: 'mb-10 → sm:mb-12' },
    { name: 'Inline gap', value: 'gap-4 · gap-6 · gap-8' }
];

const index = [
    { id: 'sg-colors', title: 'Colour' },
    { id: 'sg-type', title: 'Typography' },
    { id: 'sg-icons', title: 'Iconography' },
    { id: 'sg-layout', title: 'Layout, borders & shape' },
    {
        id: 'sg-components',
        title: 'Components',
        children: [
            { id: 'c-button', title: 'Button' },
            { id: 'c-icon-button', title: 'Icon button' },
            { id: 'c-text-field', title: 'Text field' },
            { id: 'c-link', title: 'Text link' },
            { id: 'c-project-preview', title: 'Project preview' },
            { id: 'c-post-preview', title: 'Note preview' },
            { id: 'c-pagination', title: 'Pagination' },
            { id: 'c-also-worked-with', title: 'Also worked with' }
        ]
    },
    { id: 'sg-rules', title: 'Rules' }
];

const sectionClass = 'mb-16 scroll-mt-8 sm:mb-24';
const headingClass = 'border-main mb-8 border-b border-dashed pb-2 font-serif';
---

<BaseLayout title="Styleguide" description="Design tokens, typography and components that make up josbezemer.nl." showHeader={false}>
    <meta slot="head" name="robots" content="noindex" />
    <article class="mb-16 sm:mb-24">
        <header class="mb-12">
            <h6>Design system</h6>
            <h1 class="mt-2 text-3xl leading-tight sm:text-5xl sm:leading-tight">Styleguide</h1>
            <p class="mt-4 max-w-xl text-sm leading-normal">
                The tokens, type and components behind this site. Everything below is rendered with the real components, so this page cannot drift from
                production. Toggle the theme in the top right to check dark mode.
            </p>
        </header>

        <nav aria-label="Styleguide index" class="border-main mb-16 border border-dashed p-6 sm:mb-24">
            <h5 class="mb-4">Index</h5>
            <ol class="gap-x-8 text-sm sm:columns-2 [&>li]:mb-1 [&>li]:break-inside-avoid">
                {
                    index.map((item, i) => (
                        <li>
                            <a class="hover:underline hover:underline-offset-2" href={`#${item.id}`}>
                                <span class="opacity-55">{String(i + 1).padStart(2, '0')}</span> {item.title}
                            </a>
                            {item.children && (
                                <ol class="mt-1 mb-2 ml-7 flex flex-col gap-1">
                                    {item.children.map((child) => (
                                        <li>
                                            <a class="hover:underline hover:underline-offset-2" href={`#${child.id}`}>
                                                {child.title}
                                            </a>
                                        </li>
                                    ))}
                                </ol>
                            )}
                        </li>
                    ))
                }
            </ol>
        </nav>

        <section class={sectionClass} id="sg-colors" aria-labelledby="sg-colors-h">
            <h2 id="sg-colors-h" class={headingClass}>Colour</h2>

            <h5 class="mb-4">Primitives</h5>
            <ul class="mb-12 grid grid-cols-2 gap-6 sm:grid-cols-4">
                {
                    primitives.map((p) => (
                        <li class="flex items-center gap-3">
                            <span class="border-main/15 h-12 w-12 shrink-0 rounded-full border" style={`background: var(${p.token})`} />
                            <span class="text-sm leading-tight">
                                <code class="block">{p.token.replace('--color-', '')}</code>
                                <span class="opacity-55">{p.hex}</span>
                            </span>
                        </li>
                    ))
                }
            </ul>

            <h5 class="mb-4">Semantic</h5>
            <div class="mb-12 overflow-x-auto">
                <table class="w-full min-w-xl text-left text-sm">
                    <thead>
                        <tr class="border-main border-b border-dashed">
                            <th class="py-2 pr-4 font-medium">Token</th>
                            <th class="py-2 pr-4 font-medium">Utility</th>
                            <th class="py-2 pr-4 font-medium">Light</th>
                            <th class="py-2 pr-4 font-medium">Dark</th>
                            <th class="py-2 font-medium">Use</th>
                        </tr>
                    </thead>
                    <tbody>
                        {
                            semantic.map((s) => (
                                <tr class="border-main/15 border-b">
                                    <td class="py-2 pr-4">
                                        <span class="inline-flex items-center gap-2">
                                            <span class="border-main/15 h-4 w-4 rounded-full border" style={`background: var(${s.token})`} />
                                            <code>{s.token}</code>
                                        </span>
                                    </td>
                                    <td class="py-2 pr-4">
                                        <code>{s.utility}</code>
                                    </td>
                                    <td class="py-2 pr-4 opacity-55">{s.light.replace('--color-', '')}</td>
                                    <td class="py-2 pr-4 opacity-55">{s.dark.replace('--color-', '')}</td>
                                    <td class="py-2">{s.use}</td>
                                </tr>
                            ))
                        }
                    </tbody>
                </table>
            </div>

            <h5 class="mb-4">Contrast (WCAG AA ≥ 4.5)</h5>
            <ul class="text-sm">
                {
                    contrast.map((c) => (
                        <li class="flex justify-between gap-4 py-1">
                            <span>{c.pair}</span>
                            <span class="opacity-55">{c.ratio}</span>
                        </li>
                    ))
                }
            </ul>
        </section>

        <section class={sectionClass} id="sg-type" aria-labelledby="sg-type-h">
            <h2 id="sg-type-h" class={headingClass}>Typography</h2>
            <p class="mb-8 text-sm leading-normal">
                <strong class="font-medium">Syne</strong> (<code>font-serif</code>) for headings, navigation and buttons.
                <strong class="font-medium">Epilogue</strong> (<code>font-sans</code>) for body text and meta.
            </p>

            <div class="flex flex-col gap-8">
                {
                    typeScale.map((t) => {
                        const Tag = t.name as 'h1';
                        return (
                            <div>
                                <p class="mb-1 text-xs opacity-55">
                                    <code>{t.name}</code> · {t.spec}
                                </p>
                                <Tag>{t.sample}</Tag>
                            </div>
                        );
                    })
                }
                <div>
                    <p class="mb-1 text-xs opacity-55">Page title · <code>text-3xl sm:text-5xl leading-tight</code></p>
                    <p class="font-serif text-3xl leading-tight font-bold sm:text-5xl">Good UX starts before the interface.</p>
                </div>
                <div>
                    <p class="mb-1 text-xs opacity-55">Eyebrow · <code>text-xs font-medium tracking-[0.08em] uppercase opacity-55</code></p>
                    <p class="font-sans text-xs font-medium tracking-[0.08em] uppercase opacity-55">Case study</p>
                </div>
                <div>
                    <p class="mb-1 text-xs opacity-55">Meta · <code>text-sm opacity-55</code></p>
                    <p class="text-sm opacity-55">Lead UX Designer · 2025 · 6 months</p>
                </div>
            </div>

            <h5 class="mt-12 mb-4">Long-form (<code>prose sm:prose-lg</code>)</h5>
            <div class="prose sm:prose-lg max-w-none">
                <p>
                    I work on the architecture underneath the interface. The objects, models, flows and decisions that shape every screen,
                    <a href="#">before a single component is drawn</a>.
                </p>
                <blockquote><p>Prompts are the new design choices. Naked, unable to hide behind anything.</p></blockquote>
                <ul>
                    <li>Object models first</li>
                    <li>Flows second</li>
                    <li>Screens last</li>
                </ul>
            </div>
        </section>

        <section class={sectionClass} id="sg-icons" aria-labelledby="sg-icons-h">
            <h2 id="sg-icons-h" class={headingClass}>Iconography</h2>
            <p class="mb-8 max-w-xl text-sm leading-normal">
                <a
                    class="text-accent underline decoration-dashed underline-offset-2 hover:decoration-solid"
                    href="https://fonts.google.com/icons?icon.style=Sharp">Material Symbols Sharp</a
                >, weight 400, inlined as SVG at build time. Only the icons listed in <code>scripts/sync-icons.mjs</code> ship. Icons inherit
                <code>currentColor</code> and default to <code>1.25em</code>.
            </p>
            <ul class="mb-8 grid grid-cols-3 gap-4 sm:grid-cols-6">
                {
                    iconNames.map((name) => (
                        <li class="flex flex-col items-center gap-2 py-3 text-center">
                            <Icon name={name} size="1.5rem" />
                            <code class="text-xs opacity-55">{name}</code>
                        </li>
                    ))
                }
            </ul>
            <div class="bg-muted overflow-x-auto rounded-md p-4 text-xs leading-relaxed">
                <code class="block whitespace-pre"
                    >{
                        `<Icon name="arrow_forward" />                 // decorative, next to text
<Icon name="download" label="Download" />     // standalone, announced
<Icon name="info" size="1rem" />

// New icon: add its name to scripts/sync-icons.mjs, then
npm run icons`
                    }</code
                >
            </div>
        </section>

        <section class={sectionClass} id="sg-layout" aria-labelledby="sg-layout-h">
            <h2 id="sg-layout-h" class={headingClass}>Layout, borders & shape</h2>
            <ul class="mb-10 text-sm">
                {
                    spacing.map((s) => (
                        <li class="flex justify-between gap-4 py-1">
                            <span>{s.name}</span>
                            <code class="opacity-55">{s.value}</code>
                        </li>
                    ))
                }
            </ul>
            <div class="grid grid-cols-1 gap-6 sm:grid-cols-4">
                <div class="border-main flex h-24 items-center justify-center border border-dashed text-sm">Dashed · containers</div>
                <div class="border-main flex h-24 items-center justify-center border-t border-dashed text-sm">Dashed top · dividers</div>
                <div class="border-main flex h-24 items-center justify-center rounded-md border text-sm">rounded-md · buttons</div>
                <div class="border-main flex h-24 items-center justify-center rounded-full border text-sm">rounded-full · inputs</div>
            </div>
            <p class="mt-6 text-sm leading-normal">
                Focus: every focusable element gets a 2px <code>--accent</code> outline with 2px offset on <code>:focus-visible</code> (set globally in
                <code>global.css</code>). Never remove it.
            </p>
        </section>

        <section class={sectionClass} id="sg-components" aria-labelledby="sg-components-h">
            <h2 id="sg-components-h" class={headingClass}>Components</h2>

            <div class="flex flex-col gap-16">
                <Spec
                    id="c-button"
                    title="Button"
                    file="src/components/Button.astro"
                    description="Renders <a> when href is set, otherwise <button>. One primary per view."
                    props={[
                        { name: 'variant', type: "'primary' | 'secondary'", default: "'secondary'", description: 'Primary is filled; secondary is outlined.' },
                        { name: 'icon', type: 'IconName', description: 'Optional icon from the icon set.' },
                        { name: 'iconPosition', type: "'start' | 'end'", default: "'end'", description: 'Side of the label the icon sits on.' },
                        { name: 'href', type: 'string', description: 'Turns the button into a link.' },
                        { name: '...rest', type: 'HTML attributes', description: 'Passed to the <a> or <button>.' }
                    ]}
                    usage={`<Button href="/contact" variant="primary" icon="arrow_forward">Get in touch</Button>
<Button href="/app.dmg" variant="primary" icon="download" iconPosition="start">Download</Button>
<Button type="submit">Subscribe</Button>`}
                >
                    <div class="flex flex-wrap items-center gap-4">
                        <Button href="#" variant="primary">Primary</Button>
                        <Button href="#" variant="primary" icon="arrow_forward">With icon</Button>
                        <Button href="#" variant="primary" icon="download" iconPosition="start">Download</Button>
                    </div>
                    <div class="flex flex-wrap items-center gap-4">
                        <Button href="#">Secondary</Button>
                        <Button href="#" icon="open_in_new">External</Button>
                        <Button type="button" disabled class="cursor-not-allowed opacity-55">Disabled</Button>
                    </div>
                </Spec>

                <Spec
                    id="c-icon-button"
                    title="Icon button"
                    file="src/components/IconButton.astro"
                    description="Square-ish round control for a single icon. Always give it an aria-label."
                    props={[
                        { name: 'aria-label', type: 'string', description: 'Required. The accessible name.' },
                        { name: 'href', type: 'string', description: 'Turns it into a link.' }
                    ]}
                    usage={`<IconButton href="/notes/2" aria-label="Next page">
    <Icon name="arrow_forward" />
</IconButton>`}
                >
                    <div class="flex gap-4">
                        <IconButton type="button" aria-label="Previous"><Icon name="arrow_back" /></IconButton>
                        <IconButton type="button" aria-label="Next"><Icon name="arrow_forward" /></IconButton>
                        <IconButton type="button" aria-label="Close"><Icon name="close" /></IconButton>
                    </div>
                </Spec>

                <Spec
                    id="c-text-field"
                    title="Text field"
                    file="src/components/TextField.astro"
                    description="Labelled input with optional hint and error. Error sets aria-invalid and links the message via aria-describedby."
                    props={[
                        { name: 'label', type: 'string', description: 'Required. Visible label.' },
                        { name: 'name', type: 'string', description: 'Required. Also used as id unless id is set.' },
                        { name: 'hideLabel', type: 'boolean', default: 'false', description: 'Keeps the label for screen readers only.' },
                        { name: 'hint', type: 'string', description: 'Helper text under the field.' },
                        { name: 'error', type: 'string', description: 'Puts the field in its error state with this message.' },
                        { name: '...rest', type: 'input attributes', description: 'type, required, placeholder, autocomplete…' }
                    ]}
                    usage={`<TextField label="Email address" name="email" type="email" required />
<TextField label="Email address" name="email" type="email"
    error="Enter an email address like name@example.com" />`}
                >
                    <div class="grid gap-6 sm:grid-cols-2">
                        <TextField label="Default" name="sg-default" placeholder="name@example.com" />
                        <TextField label="With hint" name="sg-hint" placeholder="name@example.com" hint="We only use this to reply." />
                        <TextField label="Error" name="sg-error" type="email" value="jos@" error="Enter an email address like name@example.com" />
                        <TextField label="Disabled" name="sg-disabled" placeholder="name@example.com" disabled class="opacity-55" />
                    </div>
                </Spec>

                <Spec
                    id="c-link"
                    title="Text link"
                    file="src/styles/global.css (.prose a)"
                    description="Inline links in long-form text: accent colour, dashed underline, solid on hover."
                >
                    <div class="prose">
                        <p>Read more in <a href="#">the notes</a>.</p>
                    </div>
                </Spec>

                {
                    sampleProject && (
                        <Spec
                            id="c-project-preview"
                            title="Project preview"
                            file="src/components/ProjectPreview.astro"
                            props={[
                                { name: 'project', type: "CollectionEntry<'projects'>", description: 'Required.' },
                                { name: 'headingLevel', type: "'h2' | 'h3'", default: "'h2'", description: 'Match the page outline.' }
                            ]}
                        >
                            <ProjectPreview project={sampleProject} headingLevel="h3" />
                        </Spec>
                    )
                }

                {
                    samplePost && (
                        <Spec
                            id="c-post-preview"
                            title="Note preview"
                            file="src/components/PostPreview.astro"
                            props={[
                                { name: 'post', type: "CollectionEntry<'blog'>", description: 'Required.' },
                                { name: 'headingLevel', type: "'h2' | 'h3'", default: "'h2'", description: 'Match the page outline.' }
                            ]}
                        >
                            <PostPreview post={samplePost} headingLevel="h3" />
                        </Spec>
                    )
                }

                <Spec
                    id="c-pagination"
                    title="Pagination"
                    file="src/components/Pagination.astro"
                    props={[{ name: 'page', type: 'Page', description: "Astro's paginate() page." }]}
                >
                    <Pagination page={samplePage} />
                </Spec>

                <Spec
                    id="c-also-worked-with"
                    title="Also worked with"
                    file="src/components/AlsoWorkedWith.astro"
                    description="Reads siteConfig.alsoWorkedWith."
                >
                    <AlsoWorkedWith />
                </Spec>
            </div>
        </section>

        <section class="scroll-mt-8" id="sg-rules" aria-labelledby="sg-rules-h">
            <h2 id="sg-rules-h" class={headingClass}>Rules</h2>
            <ul class="flex flex-col gap-2 text-sm leading-normal">
                <li>
                    Use semantic utilities only (<code>bg-main</code>, <code>text-main</code>, <code>border-main</code>, <code>text-accent</code>,
                    <code>text-danger</code>). No hex values in components.
                </li>
                <li>Secondary text is <code>opacity-55</code>, not a new colour.</li>
                <li>Accent is for links, active state, focus and one emphasis per view. Never for large surfaces.</li>
                <li>Danger is for errors only. Pair it with an icon and text, never colour alone.</li>
                <li>Containers and dividers use dashed borders. Buttons are <code>rounded-md</code>; icon buttons and inputs are <code>rounded-full</code>.</li>
                <li>Headings and controls in Syne, everything else in Epilogue. No third typeface.</li>
                <li>Icons only from the Material Symbols Sharp set via <code>&lt;Icon&gt;</code>. No inline SVGs or other icon libraries.</li>
                <li>New component? Add a <code>&lt;Spec&gt;</code> block to this page in the same change.</li>
            </ul>
        </section>
    </article>
</BaseLayout>
