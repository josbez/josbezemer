---
import type { HTMLAttributes } from 'astro/types';

type Variant = 'primary' | 'secondary';
type AnchorProps = HTMLAttributes<'a'> & { href: string; type?: never; variant?: Variant };
type ButtonProps = HTMLAttributes<'button'> & { href?: never; variant?: Variant };

type Props = ButtonProps | AnchorProps;

const { href, variant = 'secondary', class: className, ...rest } = Astro.props;
const baseClasses = 'inline-flex items-center justify-center px-6 py-2 font-serif leading-tight border border-main rounded-full transition-colors';
const variantClasses = {
    primary: 'bg-[var(--text-main)] text-[var(--bg-main)] font-medium hover:bg-accent hover:border-accent',
    secondary: 'text-main bg-transparent hover:bg-muted'
};
const buttonClasses = [baseClasses, variantClasses[variant]];
---

{
    href ? (
        <a href={href} class:list={[buttonClasses, className]} {...rest}>
            <slot />
        </a>
    ) : (
        <button class:list={[buttonClasses, 'cursor-pointer', className]} {...rest}>
            <slot />
        </button>
    )
}
