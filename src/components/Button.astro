---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';
import type { IconName } from './icon-names';

type Variant = 'primary' | 'secondary';
type SharedProps = { variant?: Variant; icon?: IconName; iconPosition?: 'start' | 'end' };
type AnchorProps = HTMLAttributes<'a'> & SharedProps & { href: string; type?: never };
type ButtonProps = HTMLAttributes<'button'> & SharedProps & { href?: never };

type Props = ButtonProps | AnchorProps;

const { href, variant = 'secondary', icon, iconPosition = 'end', class: className, ...rest } = Astro.props;
const baseClasses = 'inline-flex items-center justify-center gap-2 px-5 py-2.5 font-serif leading-tight border border-main rounded-md transition-colors';
const variantClasses = {
    primary: 'bg-inverse text-inverse font-medium hover:bg-accent hover:border-accent',
    secondary: 'text-main bg-transparent hover:bg-muted'
};
const buttonClasses = [baseClasses, variantClasses[variant], { 'flex-row-reverse': icon && iconPosition === 'start' }];
---

{
    href ? (
        <a href={href} class:list={[buttonClasses, className]} {...rest}>
            <span>
                <slot />
            </span>
            {icon && <Icon name={icon} size="1.125em" />}
        </a>
    ) : (
        <button class:list={[buttonClasses, 'cursor-pointer', className]} {...rest}>
            <span>
                <slot />
            </span>
            {icon && <Icon name={icon} size="1.125em" />}
        </button>
    )
}
