---
import NavLink from './NavLink.astro';
import ThemeToggle from './ThemeToggle.astro';
import siteConfig from '../data/site-config';

const navLinks = siteConfig.headerNavLinks ?? [];
---

<nav class="relative min-h-10 pt-4 pb-12 sm:min-h-14 sm:pb-24 md:pt-8" aria-label="Primary navigation">
    <div class="relative mx-auto flex w-full max-w-3xl items-center gap-6">
        {
            navLinks.length > 0 && (
                <button
                    class="menu-toggle relative z-30 -ml-1 flex h-8 w-8 cursor-pointer items-center justify-center md:hidden"
                    aria-label="Open Menu"
                    aria-expanded="false"
                    aria-controls="menu-items"
                >
                    <span class="menu-toggle-icon relative h-px w-6 bg-current" />
                </button>
            )
        }
        <a
            href="/"
            class="text-main relative z-30 font-serif text-xl hover:underline hover:decoration-1 hover:underline-offset-2 md:text-base"
        >
            Jos Bezemer
        </a>
        {
            navLinks.length > 0 && (
                <ul
                    id="menu-items"
                    class="menu max-md:bg-main max-md:border-main flex gap-6 max-md:absolute max-md:-top-2.5 max-md:-left-2.5 max-md:z-20 max-md:max-w-64 max-md:flex-col max-md:gap-1 max-md:border max-md:border-dashed max-md:px-3 max-md:pt-16 max-md:pb-10"
                >
                    {navLinks.map((link) => (
                        <li class="py-1">
                            <NavLink
                                class="text-main font-serif text-xl hover:underline hover:decoration-1 hover:underline-offset-2 md:text-base"
                                href={link.href}
                            >
                                {link.text}
                            </NavLink>
                        </li>
                    ))}
                </ul>
            )
        }
    </div>
    <div class="absolute top-4 right-0 z-10 md:top-8">
        <ThemeToggle />
    </div>
</nav>

<style>
    @reference "tailwindcss";

    @media (max-width: 767px) {
        .menu {
            @apply invisible opacity-0;
            width: calc(100% + 1.25rem);
        }
        .menu.is-visible {
            @apply visible opacity-100;
            transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
        }
        .menu-toggle-icon {
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
        }
        .menu-toggle.is-active .menu-toggle-icon {
            @apply w-0;
            transition: width 0.1s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .menu-toggle-icon:before,
        .menu-toggle-icon:after {
            @apply absolute top-0 left-1/2 h-px w-6 origin-center -translate-x-1/2 bg-current;
            content: '';
            transition:
                rotate 0.2s cubic-bezier(0.4, 0, 0.2, 1),
                margin 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.2s;
        }
        .menu-toggle-icon:before {
            @apply -mt-1.5;
        }
        .menu-toggle-icon:after {
            @apply mt-1.5;
        }
        .menu-toggle.is-active .menu-toggle-icon:before,
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply mt-0;
            transition:
                margin 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.1s,
                rotate 0.2s cubic-bezier(0.4, 0, 0.2, 1) 0.3s;
        }
        .menu-toggle.is-active .menu-toggle-icon:before {
            @apply rotate-45;
        }
        .menu-toggle.is-active .menu-toggle-icon:after {
            @apply -rotate-45;
        }
    }
</style>

<script>
    function getMenuEls() {
        return {
            menu: document.querySelector('.menu'),
            btn: document.querySelector('.menu-toggle')
        };
    }

    function openMenu(btn, menu) {
        btn.classList.add('is-active');
        btn.setAttribute('aria-expanded', 'true');
        btn.setAttribute('aria-label', 'Close Menu');
        menu?.classList.add('is-visible');
    }

    function closeMenu(btn, menu) {
        btn.classList.remove('is-active');
        btn.setAttribute('aria-expanded', 'false');
        btn.setAttribute('aria-label', 'Open Menu');
        menu?.classList.remove('is-visible');
    }

    // Rebind the click handler after each view transition. Uses onclick (not
    // addEventListener) so re-running this never stacks duplicate handlers.
    function bindMenuToggle() {
        const { menu, btn } = getMenuEls();
        if (!btn) return;
        btn.onclick = () => {
            const isExpanded = btn.getAttribute('aria-expanded') === 'true';
            if (isExpanded) closeMenu(btn, menu);
            else openMenu(btn, menu);
        };
    }

    // Escape closes the menu and returns focus to the toggle button.
    function handleKeydown(e) {
        if (e.key !== 'Escape') return;
        const { menu, btn } = getMenuEls();
        if (!btn || btn.getAttribute('aria-expanded') !== 'true') return;
        closeMenu(btn, menu);
        btn.focus();
    }

    // A click outside the open menu (and outside the toggle) closes it.
    function handleClickOutside(e) {
        const { menu, btn } = getMenuEls();
        if (!btn || btn.getAttribute('aria-expanded') !== 'true') return;
        if (btn.contains(e.target) || menu?.contains(e.target)) return;
        closeMenu(btn, menu);
    }

    // Document-level listeners survive view transitions, so bind them once.
    if (!window.__navMenuBound) {
        document.addEventListener('keydown', handleKeydown);
        document.addEventListener('click', handleClickOutside);
        window.__navMenuBound = true;
    }

    bindMenuToggle();
    document.addEventListener('astro:after-swap', bindMenuToggle);
</script>
