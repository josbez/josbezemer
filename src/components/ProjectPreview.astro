---
import { type CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';

type Props = { project: CollectionEntry<'projects'>; class?: string; headingLevel?: 'h2' | 'h3' };

const { project, class: className, headingLevel = 'h2' } = Astro.props;
const { title, tagline, description, duration, role, client } = project.data;
const TitleTag = headingLevel;
const meta = [role, client, duration].filter(Boolean);
---

<a class:list={['group flex items-start justify-between gap-8', className]} href={`/projects/${project.id}/`}>
    <div class="grow">
        <p class="text-subtle font-sans text-xs font-medium tracking-[0.08em] uppercase">{title}</p>
        <TitleTag
            class="mt-1 font-serif text-xl leading-tight font-medium group-hover:underline group-hover:decoration-dashed group-hover:decoration-1 group-hover:underline-offset-4 sm:text-2xl"
        >
            {tagline ?? title}
        </TitleTag>
        {meta.length > 0 && <div class="text-subtle mt-1 text-sm">{meta.join(' · ')}</div>}
        {description && <div class="mt-1 text-sm leading-normal">{description}</div>}
    </div>
    <div
        class="hidden font-serif italic opacity-0 transition group-hover:opacity-100 group-focus-visible:opacity-100 sm:inline-flex sm:shrink-0 sm:items-center sm:gap-1"
    >
        View Project <Icon name="arrow_forward" size="1rem" />
    </div>
</a>
